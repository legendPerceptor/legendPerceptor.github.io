# --- storage ---------------------------------------------------------------
# Where subscribers.db lives. In Docker this is usually /data (a volume).
DATA_DIR=data
DB_FILE=subscribers.db

# --- security --------------------------------------------------------------
# Bearer token for /api/admin/*. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave empty to disable the admin HTTP endpoints completely (CLI still works).
ADMIN_TOKEN=
# Salt used to hash visitor IPs before they touch the database.
IP_SALT=
# Set to true only when a reverse proxy (Caddy/nginx) sits in front and sets
# X-Forwarded-For; otherwise clients could spoof their IP.
TRUST_PROXY=true

# --- limits ----------------------------------------------------------------
RATE_LIMIT=5
RATE_WINDOW_SECONDS=600
MAX_BODY_BYTES=4096

# --- site ------------------------------------------------------------------
SITE_URL=https://www.yuanjianliu.net
# Browser origins allowed to call the API (comma separated).
ALLOWED_ORIGINS=https://www.yuanjianliu.net,https://legendperceptor.github.io,http://localhost:4000,http://127.0.0.1:4000

# --- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
