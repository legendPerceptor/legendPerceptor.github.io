[Unit]
Description=Email subscription API for yuanjianliu.net
Documentation=file:///opt/subscribe-server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=subscribe
Group=subscribe
WorkingDirectory=/opt/subscribe-server
EnvironmentFile=/opt/subscribe-server/.env
ExecStart=/opt/subscribe-server/.venv/bin/uvicorn app.api:create_app --factory --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/subscribe-server/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
